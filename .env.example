# EquityMux configuration — copy to .env and fill in. NEVER commit .env.

# ---------- mode ----------
# DEMO_MODE=true serves recorded fixtures (fixtures/rwa) with a visible
# RECORDED badge in the UI. LIVE is the default and hits real public endpoints.
DEMO_MODE=false

# ---------- Binance Web3 public endpoints (no API key needed) ----------
BINANCE_WWW_BASE=https://www.binance.com
BINANCE_WEB3_BASE=https://web3.binance.com

# ---------- Agentic Wallet ----------
BAW_BIN=baw

# ---------- BSC RPC (read-only: verification + simulation) ----------
BSC_RPC_URLS=https://bsc-dataseed.binance.org,https://bsc-dataseed1.defibit.io,https://bsc-dataseed1.ninicoin.io

# ---------- execution safety (system ceilings — cannot be loosened by policy) ----------
# Global kill switch. Mainnet transactions require EXECUTION_ENABLED=true AND
# a connected Agentic Wallet AND human confirmation AND fresh simulation.
EXECUTION_ENABLED=false
REQUIRE_SIMULATION=true
REQUIRE_CONFIRMATION=true
MAX_MAINNET_NOTIONAL_USD=25
ALLOWED_CHAIN_IDS=56
ALLOWED_TOKEN_PLATFORMS=ondo,xstocks,bstock
ALLOWED_QUOTE_ASSETS=USDC,USDT,USD1,U
MAX_SLIPPAGE_BPS_HARD=100
MAX_PREMIUM_BPS_HARD=100
MAX_SIMULATION_AGE_S=60
MAX_QUOTE_AGE_S=30
MAX_REFERENCE_AGE_S=900

# ---------- frontend ----------
EQUITYMUX_API=http://localhost:8000
