# EquityMux API — self-contained image (no wallet CLI; execution paths stay
# disabled by default — set EXECUTION_ENABLED only on a host with `baw` auth).
FROM python:3.12-slim

# uv for fast, reproducible dependency install
COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /usr/local/bin/uv

# Preserve the repo-relative depth: config.py computes REPO_ROOT=parents[3],
# so the package must live at <root>/services/api/equitymux.
WORKDIR /repo/services/api

COPY services/api/pyproject.toml ./
RUN uv pip install --system --no-cache \
    "fastapi>=0.115" "uvicorn[standard]>=0.30" "pydantic>=2.9" \
    "pydantic-settings>=2.5" "httpx>=0.28" "structlog>=24.4"

COPY services/api/equitymux ./equitymux
COPY fixtures /repo/fixtures
COPY dx /repo/dx

ENV PYTHONUNBUFFERED=1 \
    EXECUTION_ENABLED=false \
    DEMO_MODE=false
VOLUME /repo/data
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s \
  CMD python -c "import urllib.request,sys;sys.exit(0 if urllib.request.urlopen('http://localhost:8000/api/health',timeout=4).status==200 else 1)"

CMD ["uvicorn", "equitymux.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
